# Copie este arquivo para .env e preencha os valores reais.
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-de-app-do-google
EMAIL_TO=email-que-recebera-as-mensagens@exemplo.com
PORT=5000

# Separe múltiplas origens por vírgula, sem barra no final.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://seu-portfolio.com

# Quantidade máxima de envios por IP a cada 15 minutos.
CONTACT_RATE_LIMIT_MAX=5

# Em plataformas atrás de um único proxy reverso, use 1. Localmente, use false.
TRUST_PROXY=false
